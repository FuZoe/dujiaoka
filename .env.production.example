APP_NAME=NewZoe
APP_ENV=production
APP_KEY=base64:GENERATE_ME
APP_DEBUG=false
APP_URL=https://shop.newzoe.cloud
LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=dujiaoka
DB_USERNAME=dujiaoka
DB_PASSWORD=GENERATE_ME
DB_ROOT_PASSWORD=GENERATE_ME
MARIADB_DATABASE=dujiaoka
MARIADB_USER=dujiaoka
MARIADB_PASSWORD=GENERATE_ME
MARIADB_ROOT_PASSWORD=GENERATE_ME

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120

DUJIAO_ADMIN_LANGUAGE=zh_CN
ADMIN_ROUTE_PREFIX=admin
ADMIN_HTTPS=true
SHOP_ADMIN_PASSWORD=GENERATE_ME
NEWZOE_CREATE_DEMO=true
# Owner API credentials. Generate dedicated random values; do not reuse
# payment-provider or administrator credentials.
DUJIAOKA_API_KEY=GENERATE_RANDOM_API_KEY
DUJIAOKA_API_SECRET=GENERATE_RANDOM_API_SECRET
DUJIAOKA_API_TIMESTAMP_TOLERANCE=300
DUJIAOKA_API_IDEMPOTENCY_TTL=86400
NEWZOE_PAY_BASE_URL=https://pay.newzoe.cloud
NEWZOE_PAY_SECRET=GENERATE_ME
NEWZOE_PAY_PAYMENT_MINUTES=20
NEWZOE_PAY_SETTLEMENT_GRACE_MINUTES=5
NEWZOE_PAY_WECHAT_NIGHT_PAUSE_ENABLED=true
NEWZOE_PAY_WECHAT_PAUSE_START=22:00
NEWZOE_PAY_WECHAT_PAUSE_END=06:00
NEWZOE_PAY_SCHEDULE_TIMEZONE=Asia/Shanghai

# Binance Pay personal receive account. API credentials are stored encrypted
# through the shop admin and must never be committed to this file.
BINANCE_PAY_PROXY=http://172.19.0.1:17895
BINANCE_PAY_QR_URL=https://app.binance.com/uni-qr/Sg9jgWUd
BINANCE_PAY_BASE_URL=https://api.binance.com
BINANCE_PAY_CURRENCY=USDT
BINANCE_PAY_CNY_PER_USDT=7.20000000
BINANCE_PAY_CONNECT_TIMEOUT=8
BINANCE_PAY_TIMEOUT=20
BINANCE_PAY_RECV_WINDOW=5000
BINANCE_PAY_POLL_INTERVAL_SECONDS=60
BINANCE_PAY_MAX_REQUESTS_PER_POLL=40
BINANCE_PAY_QUOTE_TTL_MINUTES=15
BINANCE_PAY_MATCH_TIME_SKEW_SECONDS=5
BINANCE_PAY_SETTLEMENT_GRACE_SECONDS=300

# Optional HTTP/SOCKS proxy for Telegram API access.
TELEGRAM_PROXY=
TELEGRAM_CONNECT_TIMEOUT=5
TELEGRAM_TIMEOUT=15
TELEGRAM_BOT_USERNAME=BOT_USERNAME
TELEGRAM_WEBHOOK_SECRET=GENERATE_A_RANDOM_SECRET
