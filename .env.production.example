APP_NAME=NewZoe
APP_ENV=production
APP_KEY=base64:GENERATE_ME
APP_DEBUG=false
APP_URL=https://shop.newzoe.cloud
LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=dujiaoka
DB_USERNAME=dujiaoka
DB_PASSWORD=GENERATE_ME
DB_ROOT_PASSWORD=GENERATE_ME
MARIADB_DATABASE=dujiaoka
MARIADB_USER=dujiaoka
MARIADB_PASSWORD=GENERATE_ME
MARIADB_ROOT_PASSWORD=GENERATE_ME

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120

DUJIAO_ADMIN_LANGUAGE=zh_CN
ADMIN_ROUTE_PREFIX=admin
ADMIN_HTTPS=true
SHOP_ADMIN_PASSWORD=GENERATE_ME
NEWZOE_CREATE_DEMO=true
NEWZOE_PAY_BASE_URL=https://pay.newzoe.cloud
NEWZOE_PAY_SECRET=GENERATE_ME

# Optional HTTP/SOCKS proxy for Telegram API access.
TELEGRAM_PROXY=
TELEGRAM_CONNECT_TIMEOUT=5
TELEGRAM_TIMEOUT=15
