# Install as /etc/newzoe-backup/backup.env with mode 0600. Do not commit the
# real file: it names the private Drive remote and repository credentials.
RCLONE_CONFIG=/etc/newzoe-backup/rclone.conf
RCLONE_REMOTE=newzoe_gdrive
RESTIC_REPOSITORY=rclone:newzoe_gdrive:NewZoe-Server-Backups/restic
RESTIC_PASSWORD_FILE=/etc/newzoe-backup/restic-password
RESTIC_CACHE_DIR=/var/lib/newzoe-backup/cache
