[Unit]
Description=NewZoe encrypted Google Drive backup
Wants=network-online.target
After=docker.service network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/newzoe-backup
TimeoutStartSec=3h
TimeoutStopSec=30s
KillMode=control-group
Nice=19
CPUQuota=70%
MemoryMax=1G
IOWeight=50
IOSchedulingClass=idle
IOSchedulingPriority=7
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/newzoe-backup /var/log/newzoe-backup /run/lock
